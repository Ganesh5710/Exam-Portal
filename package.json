{
  "name": "online-exam-portal",
  "version": "1.0.0",
  "description": "Online Examination Portal Monorepo",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma || true",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && node -e \"const fs=require('fs'),path=require('path');function c(s,d){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(i=>{const sp=path.join(s,i),dp=path.join(d,i);if(fs.statSync(sp).isDirectory())c(sp,dp);else fs.copyFileSync(sp,dp);})}c('./backend/src','./backend/dist');\"",
    "postinstall": "npx prisma generate --schema=backend/prisma/schema.prisma || true"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "docker": "^1.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
